# ---- Database (Postgres) ----
POSTGRES_DB=slough_tuition
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---- SMTP (1&1 IONOS) ----
# Fill these in to switch from console-out (dev) to real email delivery.
EMAIL_HOST=smtp.ionos.co.uk
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-tuition-centre@your-domain.co.uk
EMAIL_HOST_PASSWORD=YOUR_MASTER_EMAIL_PASSWORD
EMAIL_TIMEOUT=30

# ---- Admin alerts ----
# Where mail_admins() sends the "new enrolment" notification.
ADMIN_EMAIL=admin@sloughtuitioncentre.co.uk
# Optional override; defaults to EMAIL_HOST_USER when SMTP is on.
#DEFAULT_FROM_EMAIL=Slough Tuition Centre <no-reply@sloughtuitioncentre.co.uk>
